digraph "TradeManager trade management"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir=LR;
  Node2 [id="Node000002",label="Hikyuu core engine\l library",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group___hikyuu.html",tooltip="The core library, it contains the stock data management, the indicator implementation,..."];
  Node5 [id="Node000005",label="OrderBroker order broker",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group___order_broker.html",tooltip="The order broker, it implements the actual order operations and the programmatic orders"];
  Node6 [id="Node000006",label="Performance performance\l statistics",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group___performance.html",tooltip="The performance statistics of the trades"];
  Node3 [id="Node000003",label="TradeCost trade cost\l algorithm",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group___trade_cost.html",tooltip="The trade cost algorithms, such as the A-share cost calculation (stamp duty / commission,..."];
  Node1 [id="Node000001",label="TradeManager trade\l management",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Trade management, responsible for recording every trade record and the current positions"];
  Node4 [id="Node000004",label="TradeManager trade\l management class",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group___trade_manager_class.html",tooltip="Trade management can be understood as a simulated account for simulated trading."];
  Node2->Node1 [shape=plaintext, dir="back", style="solid"];
  Node1->Node3 [shape=plaintext, dir="back", style="solid"];
  Node1->Node4 [shape=plaintext, dir="back", style="solid"];
  Node1->Node5 [shape=plaintext, dir="back", style="solid"];
  Node1->Node6 [shape=plaintext, dir="back", style="solid"];
